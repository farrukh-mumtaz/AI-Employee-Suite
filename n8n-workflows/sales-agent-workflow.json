        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a sales assistant for a company.\\n\\nCustomer name: {{ $('Webhook').item.json.body.name }}\\nCustomer message: {{ $('Webhook').item.json.body.message }}\\n\\nYour reply must directly reference what they specifically asked about — do not give a generic response.\\n\\nDo the following:\\n1. Classify their interest as Hot, Warm, or Cold\\n2. Write a short, friendly reply addressed to them by name, that directly responds to their specific message, and asks one follow-up question\\n\\nRespond ONLY in this JSON format, nothing else:\\n{\\\"intent\\\": \\\"hot/warm/cold\\\", \\\"reply\\\": \\\"your reply here\\\"}\"\n    }\n  ],\n  \"temperature\": 0.3\n}",
